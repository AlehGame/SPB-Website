# Переопределяет значения по умолчанию из src/lib/portfolio.ts (для локальной разработки: .env.local)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
# Адрес Cloudflare Worker, принимающего заявки (см. README, раздел про форму)
